DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=haircreed
DB_USER=haircreed
DB_PASSWORD=change-me
DB_CONNECTION_LIMIT=10

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me

SUPER_ADMIN_PASSWORD=change-me# InstantDB Configuration
INSTANT_APP_ID=your_app_id_here
INSTANT_ADMIN_TOKEN=your_admin_token_here

# Authentication
# Use a long random value from the deployment platform's secret manager.
# Rotating this value invalidates all existing access tokens.
JWT_SECRET=replace_with_a_long_random_secret
# Access-token lifetime in seconds (default: 28800 / 8 hours).
JWT_EXPIRES_IN=28800

# Backup Encryption Password
# Used to encrypt/decrypt backup files - keep this secure!
BACKUP_PASSWORD=your_secure_backup_password_here
